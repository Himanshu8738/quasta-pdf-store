<aside class="drawer" id="cartDrawer">
  <div class="drawer-head"><h3>Your Cart</h3><button onclick="closeCart()">&times;</button></div>
  <div class="drawer-items" id="drawerItems"></div>
  <div class="drawer-foot">
    <div class="drawer-total"><span>Total</span><span id="drawerTotal">₹0</span></div>
