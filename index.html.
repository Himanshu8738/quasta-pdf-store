<script>
/* ============================================================
   ⚙️  EDIT YOUR DETAILS HERE
   ============================================================ */
const CONFIG = {
  sellerEmail: "quasta.connect@gmail.com", // orders are emailed here via FormSubmit
  upiId: "9984766142-2@ybl",              // your real UPI ID
  upiPayeeName: "Himanshu",                    // shown inside UPI apps
  whatsappNumber: "9984766142"                       // optional fallback, country code + number, no + or spaces
};

const PRODUCTS = [
  {id:"idea-vault", title:"Spice Startup Launch Roadmap", cat:"Business Ideas", price:1,
   desc:"A sequential, no-fluff plan to take an idea to your first paying customer in 90 days."},
  {id:"idea-vault", title:"Banana  Chips business roadmap", cat:"Business Ideas", price:39,
   desc:"How to structure a pitch, what early investors actually look for, and how to follow up."},
  {id:"idea-vault", title:"3 Business Ideas under Tier-2 20000", cat:"Business Ideas", price:99,
   desc:"Curated, under-served business ideas mapped specifically to Tier-2 and Tier-3 markets."},
  {id:"idea-vault", title:"Makhana business under 20000", cat:"Business Ideas", price:99,
   desc:"Low-cost customer acquisition tactics that work without a metro-city ad budget."},
  {id:"founder-finance", title:"Personal Finance for First-Time Founders", cat:"Finance", price:149,
   desc:"Managing personal runway, taxes and savings while building your startup."},
  {id:"investor-templates", title:"Investor Outreach Email Templates", cat:"Fundraising", price:149,
   desc:"Cold email and follow-up templates that have actually gotten founders replies."},
];
/* ============================================================ */

let cart = JSON.parse(localStorage.getItem("qd_cart") || "[]");

function renderFilters(){
  const cats = ["All", ...new Set(PRODUCTS.map(p=>p.cat))];
  document.getElementById("filters").innerHTML = cats.map((c,i)=>
    `<button class="filter-chip ${i===0?'active':''}" data-cat="${c}" onclick="filterCat('${c}', this)">${c}</button>`
  ).join("");
}

function filterCat(cat, btn){
  document.querySelectorAll(".filter-chip").forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");
  renderProducts(cat);
}

function renderProducts(filter="All"){
  const list = filter==="All" ? PRODUCTS : PRODUCTS.filter(p=>p.cat===filter);
  document.getElementById("productGrid").innerHTML = list.map(p=>{
    const inCart = cart.find(c=>c.id===p.id);
    return `
    <div class="card">
      <div class="card-cover">
        <div class="cat">${p.cat}</div>
        <div class="cover-title">${p.title}</div>
        <div class="stamp">GUIDE<br>2026</div>
      </div>
      <div class="card-body">
        <p>${p.desc}</p>
        <div class="card-foot">
          <div class="card-price">₹${p.price}</div>
          <button class="add-btn ${inCart?'added':''}" onclick="addToCart('${p.id}', this)">${inCart?'Added ✓':'Add to Cart'}</button>
        </div>
      </div>
    </div>`;
  }).join("");
}

function addToCart(id, btn){
  const p = PRODUCTS.find(x=>x.id===id);
  if(!cart.find(c=>c.id===id)){
    cart.push({id:p.id, title:p.title, price:p.price});
    saveCart();
    showToast(p.title + " added to cart");
  }
  btn.textContent = "Added ✓";
  btn.classList.add("added");
}

function saveCart(){
  localStorage.setItem("qd_cart", JSON.stringify(cart));
  document.getElementById("cartCount").textContent = cart.length;
}

function showToast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"), 2400);
}

function openCart(){
  renderDrawer();
  document.getElementById("overlay").classList.add("show");
  document.getElementById("cartDrawer").classList.add("show");
}
function closeCart(){
  document.getElementById("overlay").classList.remove("show");
  document.getElementById("cartDrawer").classList.remove("show");
}

function renderDrawer(){
  const wrap = document.getElementById("drawerItems");
  wrap.innerHTML = cart.length===0
    ? `<div class="empty">Your cart is empty. Add a guide to get started.</div>`
    : cart.map(c=>`
      <div class="drawer-line">
        <div><h5>${c.title}</h5><button class="rm" onclick="removeFromCart('${c.id}')">Remove</button></div>
        <div>₹${c.price}</div>
      </div>`).join("");
  const total = cart.reduce((s,c)=>s+c.price,0);
  document.getElementById("drawerTotal").textContent = "₹"+total;
  document.getElementById("checkoutBtn").disabled = cart.length===0;
}

function removeFromCart(id){
  cart = cart.filter(c=>c.id!==id);
  saveCart();
  renderDrawer();
  renderProducts(document.querySelector(".filter-chip.active")?.dataset.cat || "All");
}

/* ---------- Checkout ---------- */
function openCheckout(){
  if(cart.length===0) return;
  closeCart();
  const total = cart.reduce((s,c)=>s+c.price,0);
  document.getElementById("amountLine").innerHTML = "₹"+total+"<span>Amount to pay</span>";
  document.getElementById("upiIdDisplay").textContent = CONFIG.upiId;

  const ref = "QD-" + Date.now().toString().slice(-6);
  const upiUri = `upi://pay?pa=${encodeURIComponent(CONFIG.upiId)}&pn=${encodeURIComponent(CONFIG.upiPayeeName)}&am=${total}&cu=INR&tn=${ref}`;
  document.getElementById("qrImg").src = "https://api.qrserver.com/v1/create-qr-code/?size=190x190&data=" + encodeURIComponent(upiUri);
  document.getElementById("upiAppLink").href = upiUri;

  const summary = cart.map(c=>c.title+" — ₹"+c.price).join("\\n") + "\\nTotal: ₹"+total + "\\nRef: "+ref;
  document.querySelector('textarea[name="order_summary"]').value = summary;

  const waMsg = "Hi! I want to order:\\n" + cart.map(c=>c.title).join("\\n") + "\\nTotal: ₹"+total+"\\n\\nPlease confirm payment details.";
  document.getElementById("waFallback").href = "https://wa.me/" + CONFIG.whatsappNumber + "?text=" + encodeURIComponent(waMsg);

  showStep("stepPay");
  document.getElementById("checkoutModal").classList.add("show");
}

function closeCheckout(){ document.getElementById("checkoutModal").classList.remove("show"); }
function goToDetails(){ showStep("stepDetails"); }
function showStep(id){
  document.querySelectorAll(".step").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}
function copyUpi(){
  navigator.clipboard.writeText(CONFIG.upiId);
  showToast("UPI ID copied");
}

document.getElementById("orderForm").addEventListener("submit", function(e){
  e.preventDefault();
  const errEl = document.getElementById("formError");
  errEl.style.display = "none";
  const data = new FormData(e.target);

  fetch("https://formsubmit.co/ajax/" + CONFIG.sellerEmail, {
    method:"POST", headers:{"Accept":"application/json"}, body:data
  })
  .then(res => { if(!res.ok) throw new Error("send failed"); return res.json(); })
  .then(() => {
    cart = [];
    saveCart();
    renderProducts(document.querySelector(".filter-chip.active")?.dataset.cat || "All");
    showStep("stepSuccess");
  })
  .catch(() => { errEl.style.display = "block"; });
});

function finishCheckout(){ closeCheckout(); }

renderFilters();
renderProducts();
saveCart();
</script>

