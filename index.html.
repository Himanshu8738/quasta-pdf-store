<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quasta Diversity — Founder Guides</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>

  /* ============================================================
     ⚙️  EDIT YOUR DETAILS HERE — scroll to the CONFIG block near
     the bottom of the <script> to set your email, UPI ID and
     WhatsApp number. Products are listed right below CONFIG.
     ============================================================ */

  :root{
    --navy:#0E1B34;
    --navy-deep:#081120;
    --gold:#C9A24B;
    --gold-soft:#E4C77A;
    --cream:#F6F1E6;
    --ink:#1B1B1B;
    --line:rgba(201,162,75,0.28);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Manrope',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{font-family:'Fraunces',serif; font-weight:600;}
  a{text-decoration:none;color:inherit;}
  img{max-width:100%;display:block;}
  button{font-family:'Manrope',sans-serif;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 6vw;
    background:var(--navy-deep);
    color:var(--cream);
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;align-items:center;gap:10px; font-family:'Fraunces',serif; font-size:1.1rem; letter-spacing:0.02em;}
  .brand .mark{
    width:34px;height:34px; border:1.5px solid var(--gold); border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif; font-weight:600; color:var(--gold); font-size:1rem;
  }
  .brand small{display:block; font-family:'Manrope',sans-serif; font-size:0.6rem; letter-spacing:0.14em; color:var(--gold-soft); text-transform:uppercase; margin-top:2px;}

  .cart-btn{
    display:flex;align-items:center;gap:8px;
    background:transparent; border:1px solid rgba(246,241,230,0.25);
    padding:9px 16px; border-radius:100px;
    font-size:0.82rem; font-weight:600; color:var(--cream);
    cursor:pointer; transition:all .2s ease;
  }
  .cart-btn:hover{border-color:var(--gold); color:var(--gold-soft);}
  .cart-btn .count{
    background:var(--gold); color:var(--navy-deep); font-weight:800;
    border-radius:50%; width:19px; height:19px; font-size:0.68rem;
    display:flex; align-items:center; justify-content:center;
  }

  /* ---------- Hero ---------- */
  .hero{
    background:var(--navy); color:var(--cream);
    position:relative; overflow:hidden;
    padding:6vw 6vw 5vw;
  }
  .hero::before{
    content:""; position:absolute; inset:0;
    background:radial-gradient(600px 400px at 85% 10%, rgba(201,162,75,0.10), transparent 60%);
    pointer-events:none;
  }
  .hero-inner{position:relative; z-index:1; max-width:660px;}
  .eyebrow{
    font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--gold-soft); font-weight:700; margin-bottom:18px;
    display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:""; width:24px;height:1px; background:var(--gold); display:inline-block;}
  .hero h1{font-size:clamp(2rem,3.6vw,2.9rem); line-height:1.14; margin-bottom:18px;}
  .hero h1 em{font-style:italic; color:var(--gold-soft);}
  .hero-desc{font-size:1rem; line-height:1.7; color:rgba(246,241,230,0.78); max-width:52ch; margin-bottom:30px;}

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:9px;
    padding:14px 24px; border-radius:8px; font-size:0.9rem; font-weight:700;
    cursor:pointer; border:none; transition:transform .18s ease, box-shadow .18s ease;
  }
  .btn:active{transform:translateY(1px);}
  .btn-gold{background:linear-gradient(180deg,var(--gold-soft),var(--gold)); color:var(--navy-deep); box-shadow:0 10px 24px -8px rgba(201,162,75,0.55);}
  .btn-gold:hover{box-shadow:0 14px 28px -8px rgba(201,162,75,0.7);}
  .btn-outline{background:transparent; border:1.4px solid rgba(246,241,230,0.35); color:var(--cream);}
  .btn-outline:hover{border-color:var(--gold-soft); color:var(--gold-soft);}
  .btn-outline.dark{border-color:rgba(14,27,52,0.25); color:var(--navy);}
  .btn-outline.dark:hover{border-color:var(--gold); color:#8A6E1F;}

  .trust-line{display:flex;gap:22px;flex-wrap:wrap; font-size:0.78rem; color:rgba(246,241,230,0.55); margin-top:26px;}
  .trust-line span{display:flex;align-items:center;gap:6px;}
  .trust-line svg{width:13px;height:13px;fill:var(--gold-soft);}

  /* ---------- Catalog ---------- */
  .section{padding:5vw 6vw; max-width:1160px; margin:0 auto;}
  .section-head{display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:32px; flex-wrap:wrap; gap:14px;}
  .section-head h2{font-size:clamp(1.5rem,2.4vw,2rem); color:var(--navy);}
  .filters{display:flex; gap:9px; flex-wrap:wrap;}
  .filter-chip{
    border:1px solid rgba(14,27,52,0.15); background:#fff;
    padding:7px 15px; border-radius:100px; font-size:0.78rem; font-weight:600;
    color:#555; cursor:pointer;
  }
  .filter-chip.active{background:var(--navy); border-color:var(--navy); color:var(--cream);}

  .grid{display:grid; grid-template-columns:repeat(3,1fr); gap:26px;}
  .card{
    background:#fff; border:1px solid rgba(14,27,52,0.08); border-radius:12px;
    overflow:hidden; display:flex; flex-direction:column;
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .card:hover{transform:translateY(-4px); box-shadow:0 20px 40px -20px rgba(14,27,52,0.25);}
  .card-cover{
    background:linear-gradient(160deg,#12203F,#0B1526);
    padding:22px 20px; position:relative; min-height:120px;
    border-bottom:1px solid var(--line);
  }
  .card-cover .cat{font-size:0.6rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--gold-soft); margin-bottom:10px;}
  .card-cover .cover-title{font-family:'Fraunces',serif; font-size:1.05rem; color:var(--cream); line-height:1.3;}
  .card-cover .stamp{
    position:absolute; bottom:14px; right:16px;
    font-family:'Fraunces',serif; font-size:0.6rem; color:var(--gold-soft);
    border:1px solid var(--gold); border-radius:50%;
    width:34px;height:34px; display:flex;align-items:center;justify-content:center; text-align:center; line-height:1.1;
  }
  .card-body{padding:20px 20px 22px; display:flex; flex-direction:column; flex:1;}
  .card-body p{font-size:0.86rem; line-height:1.55; color:#555; margin-bottom:18px; flex:1;}
  .card-foot{display:flex; align-items:center; justify-content:space-between; gap:12px;}
  .card-price{font-family:'Fraunces',serif; font-size:1.25rem; color:var(--navy);}
  .add-btn{
    background:var(--navy); color:var(--cream); border:none;
    padding:9px 16px; border-radius:100px; font-size:0.8rem; font-weight:700;
    cursor:pointer; transition:background .2s ease;
  }
  .add-btn:hover{background:#1a2c52;}
  .add-btn.added{background:#3f7a5c;}

  /* ---------- What's inside ---------- */
  .feature-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
  .feature-card{background:#fff; border:1px solid rgba(14,27,52,0.08); border-radius:10px; padding:26px 22px;}
  .feature-num{
    font-family:'Fraunces',serif; font-size:0.82rem; color:var(--gold);
    border:1px solid var(--gold); width:28px;height:28px; border-radius:50%;
    display:flex;align-items:center;justify-content:center; margin-bottom:14px;
  }
  .feature-card h3{font-size:1rem; color:var(--navy); margin-bottom:6px;}
  .feature-card p{font-size:0.86rem; line-height:1.6; color:#555;}

  /* ---------- Footer ---------- */
  footer{text-align:center; padding:30px 6vw 38px; background:var(--navy-deep); color:rgba(246,241,230,0.4); font-size:0.78rem;}
  footer .gold{color:var(--gold-soft);}

  /* ---------- Toast ---------- */
  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--navy-deep); color:var(--cream); border:1px solid var(--gold);
    padding:13px 22px; border-radius:100px; font-size:0.84rem; font-weight:600;
    opacity:0; pointer-events:none; transition:all .3s ease; z-index:999;
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* ---------- Cart drawer ---------- */
  .overlay{position:fixed; inset:0; background:rgba(8,17,32,0.55); opacity:0; pointer-events:none; transition:opacity .2s ease; z-index:60;}
  .overlay.show{opacity:1; pointer-events:auto;}
  .drawer{
    position:fixed; top:0; right:0; height:100%; width:400px; max-width:92vw;
    background:var(--cream); z-index:70; transform:translateX(100%); transition:transform .25s ease;
    display:flex; flex-direction:column; box-shadow:-10px 0 30px rgba(0,0,0,0.25);
  }
  .drawer.show{transform:translateX(0);}
  .drawer-head{padding:22px 24px; background:var(--navy-deep); color:var(--cream); display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line);}
  .drawer-head h3{font-size:1.15rem;}
  .drawer-head button{background:none; border:none; color:var(--cream); font-size:22px; cursor:pointer;}
  .drawer-items{flex:1; overflow-y:auto; padding:8px 24px;}
  .drawer-line{display:flex; justify-content:space-between; align-items:flex-start; padding:16px 0; border-bottom:1px solid rgba(14,27,52,0.1);}
  .drawer-line h5{font-size:0.92rem; margin-bottom:5px; color:var(--navy);}
  .drawer-line .rm{font-size:0.76rem; color:#8A6E1F; text-decoration:underline; border:none; background:none; cursor:pointer; padding:0;}
  .empty{color:#777; font-size:0.88rem; text-align:center; padding:36px 0;}
  .drawer-foot{padding:22px 24px; border-top:1px solid rgba(14,27,52,0.1); background:#fff;}
  .drawer-total{display:flex; justify-content:space-between; align-items:center; font-family:'Fraunces',serif; font-size:1.3rem; color:var(--navy); margin-bottom:16px;}
  .drawer-foot .btn{width:100%;}
  .drawer-foot .btn:disabled{opacity:0.4; cursor:not-allowed;}

  /* ---------- Checkout modal ---------- */
  .modal{position:fixed; inset:0; z-index:80; display:none; align-items:center; justify-content:center; padding:20px;}
  .modal.show{display:flex;}
  .modal-box{
    background:var(--cream); border-radius:14px; max-width:440px; width:100%;
    max-height:90vh; overflow-y:auto; border-top:5px solid var(--gold);
    position:relative; box-shadow:0 30px 70px rgba(0,0,0,0.35);
  }
  .modal-inner{padding:30px 28px;}
  .modal-close{position:absolute; top:14px; right:18px; background:none; border:none; font-size:20px; cursor:pointer; color:#777;}
  .modal-box h3{font-size:1.3rem; color:var(--navy); margin-bottom:6px;}
  .modal-box .sub{font-size:0.82rem; color:#666; margin-bottom:20px;}
  .qr-box{text-align:center; margin:8px 0 16px;}
  .qr-box img{margin:0 auto 12px; border:1px solid var(--line); border-radius:8px;}
  .upi-id-row{
    display:flex; align-items:center; justify-content:center; gap:10px;
    font-family:'Fraunces',serif; font-size:1rem; background:#fff;
    border:1px solid var(--line); padding:10px 14px; border-radius:100px; margin-bottom:6px;
  }
  .upi-id-row button{border:1px solid var(--navy); background:none; border-radius:100px; padding:4px 12px; font-size:0.7rem; cursor:pointer; color:var(--navy);}
  .amount-line{text-align:center; font-family:'Fraunces',serif; font-size:1.7rem; color:var(--navy); margin:14px 0 4px;}
  .amount-line span{font-size:0.78rem; font-family:'Manrope',sans-serif; color:#777; display:block; margin-top:2px;}
  .pay-app-btn{display:block; text-align:center; margin-top:12px; width:100%;}
  .divider-note{font-size:0.76rem; color:#777; text-align:center; margin:18px 0 4px; border-top:1px dashed var(--line); padding-top:16px;}
  form#order-form label{display:block; font-size:0.8rem; color:#555; margin:14px 0 5px; font-weight:600;}
  form#order-form input, form#order-form textarea{
    width:100%; padding:11px 13px; border:1px solid rgba(14,27,52,0.18); border-radius:8px;
    font-family:'Manrope',sans-serif; font-size:0.88rem; background:#fff;
  }
  form#order-form input:focus, form#order-form textarea:focus{outline:none; border-color:var(--gold);}
  form#order-form textarea{resize:vertical; min-height:56px;}
  .step{display:none;}
  .step.active{display:block;}
  .success-box{text-align:center; padding:6px 0;}
  .success-box .check{
    width:52px;height:52px; border-radius:50%; background:#3f7a5c; color:#fff;
    display:flex;align-items:center;justify-content:center; margin:0 auto 16px; font-size:24px;
  }
  .error-msg{color:#a33; font-size:0.78rem; margin-top:10px; display:none;}
  .wa-fallback{display:block; text-align:center; margin-top:14px; font-size:0.78rem; color:#8A6E1F; text-decoration:underline;}

  /* ---------- Responsive ---------- */
  @media(max-width:820px){
    .grid{grid-template-columns:1fr 1fr;}
    .feature-grid{grid-template-columns:1fr;}
  }
  @media(max-width:560px){
    .grid{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

